# Copy to backend/.env. The API reads this file on startup if it is present.
#
# Run API:    cd backend && go run ./cmd/api
# Run UI:     cd frontend && npm install && npm run dev
# Open:       http://localhost:5173
#
# MongoDB must be running at MONGO_URI. No other infrastructure is required.
# Leave AI_PROVIDER=mock to use the built-in designer. It is not a live model.
# Set AI_PROVIDER=openai and AI_API_KEY to call a real model. The key stays on the server.
#
# The dashboard stays on the bare domain. Each shop is a subdomain of BASE_DOMAIN.
# Local:  http://localhost:5173 and http://your-slug.localhost:5173
# Deploy: https://your-domain and https://your-slug.your-domain
# Point both hosts at this app and proxy /api to this server. Leave COOKIE_DOMAIN empty
# so the seller session stays on the dashboard host.
#
# APP_PUBLIC_URL is the dashboard the browser opens. Google's redirect URI is
# APP_PUBLIC_URL/api/auth/google/callback. Leave the Google values empty to hide that button.
# Leave SMTP_HOST empty to write password-reset links to this server's log. The link is not
# returned by the API.

PORT=8080
MONGO_URI=mongodb://localhost:27017
MONGO_DB=sable

JWT_SECRET=replace-with-a-long-random-string
JWT_TTL_HOURS=168
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Comma-separated. Subdomains of BASE_DOMAIN are allowed in addition to this list.
CORS_ORIGINS=http://localhost:5173
BASE_DOMAIN=localhost

# mock, or openai for any OpenAI-compatible chat API.
# An OpenRouter key (sk-or-) is sent to https://openrouter.ai/api/v1
# and uses openai/gpt-4o-mini unless AI_MODEL names another model.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=60

APP_PUBLIC_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
